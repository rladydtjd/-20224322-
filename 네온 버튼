<!DOCTYPE html>
<html lang="ko">
<head>
    <style>
        body { display: flex; justify-content: center; align-items: center; height: 100vh; background: #111; }
        .neon-btn {
            padding: 15px 30px; font-size: 18px; color: #00f2fe; background: transparent;
            border: 2px solid #00f2fe; border-radius: 5px; cursor: pointer; transition: 0.5s;
        }
        .neon-btn:hover {
            background: #00f2fe; color: #111;
            box-shadow: 0 0 10px #00f2fe, 0 0 40px #00f2fe;
        }
    </style>
</head>
<body>
    <button class="neon-btn">Hover Me!</button>
</body>
</html>
